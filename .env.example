# =============================================================================
# MedRank — variáveis de ambiente
# Copie para .env.local (dev) ou configure na Vercel (produção)
# =============================================================================

# --- Supabase (obrigatório em produção) ---
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- App ---
NEXT_PUBLIC_APP_NAME=MedRank
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Modo de operação ---
# Desenvolvimento / demo local:
DEMO_MODE=true
SKIP_AUTH=false

# Produção (Vercel) — use estes valores:
# DEMO_MODE=false
# SKIP_AUTH=false
# NEXT_PUBLIC_SITE_URL=https://seu-app.vercel.app
