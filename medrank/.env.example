# =============================================================================
# MedRank — variáveis de ambiente (COMEÇAR DO ZERO)
# Copie para .env.local OU configure do zero na Vercel
# =============================================================================

NEXT_PUBLIC_APP_NAME=MedRank
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Modo demo (use isto no 1º deploy / enquanto não tem Supabase novo) ---
DEMO_MODE=true
SKIP_AUTH=false

# --- Supabase (só depois de criar projeto NOVO) ---
# Deixe comentado no começo. Não use URL/chave antigas nem "seu-projeto".
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...   # alias opcional da anon
# SUPABASE_SERVICE_ROLE_KEY=eyJ...             # só servidor

# --- Produção real (depois do Supabase novo) ---
# DEMO_MODE=false
# SKIP_AUTH=false
# NEXT_PUBLIC_SITE_URL=https://seu-app.vercel.app

# --- Cron da disputa diária (Vercel Cron injeta Authorization: Bearer) ---
# CRON_SECRET=uma-string-longa-aleatoria
